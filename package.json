{
  "name": "text-bubbles",
  "version": "1.0.0",
  "description": "Text drawn as interactive particles that scatter around the pointer. Tiny, dependency-free canvas core with React and custom element adapters.",
  "keywords": [
    "text",
    "particles",
    "bubbles",
    "canvas",
    "animation",
    "interactive",
    "hero",
    "typography",
    "react",
    "web-component",
    "custom-element",
    "astro"
  ],
  "homepage": "https://text-bubbles.pedrovilaca.dev",
  "bugs": {
    "url": "https://github.com/piique/text-bubbles/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piique/text-bubbles.git"
  },
  "license": "MIT",
  "author": "Pedro Vilaça",
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./dist/element.cjs"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ],
      "element": [
        "./dist/element.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite",
    "build:demo": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "size": "size-limit",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run size"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "size-limit": "^14.2.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.1": "0.28.2"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.9"
}
