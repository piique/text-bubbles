{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "paths": {
      "text-bubbles": ["./src/index.ts"],
      "text-bubbles/react": ["./src/react/index.tsx"],
      "text-bubbles/element": ["./src/element/index.ts"]
    }
  },
  "include": ["src", "demo", "test", "e2e", "*.ts"],
  "exclude": ["node_modules", "dist", "demo-dist", ".e2e-dist"]
}
